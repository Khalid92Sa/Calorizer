@model Calorizer.Business.DTOs.CalculationDto

@{
    ViewData["Title"] = Localizer["Calculation"];

    // Exchange values per 1 serving (CHO g, Protein g, Fat g, Kcal)
    var foodGroups = new[]
    {
        new { Key = "SkimmedMilk",   Cho = 12, Protein = 8, Fat = 0, Calories = 80,  RowClass = "table-info",      RowStyle = "" },
        new { Key = "LowFatMilk",    Cho = 12, Protein = 8, Fat = 5, Calories = 125, RowClass = "table-info",      RowStyle = "" },
        new { Key = "FullFatMilk",   Cho = 12, Protein = 8, Fat = 8, Calories = 152, RowClass = "table-info",      RowStyle = "" },
        new { Key = "Fruit",         Cho = 15, Protein = 0, Fat = 0, Calories = 60,  RowClass = "table-danger",    RowStyle = "" },
        new { Key = "Vegetable",     Cho = 5,  Protein = 2, Fat = 0, Calories = 25,  RowClass = "table-success",   RowStyle = "" },
        new { Key = "Sugar",         Cho = 5,  Protein = 0, Fat = 0, Calories = 20,  RowClass = "",                RowStyle = "" },
        new { Key = "Starch",        Cho = 15, Protein = 3, Fat = 0, Calories = 80,  RowClass = "table-warning",   RowStyle = "" },
        new { Key = "LeanMeat",      Cho = 0,  Protein = 7, Fat = 3, Calories = 55,  RowClass = "table-secondary", RowStyle = "" },
        new { Key = "MediumFatMeat", Cho = 0,  Protein = 7, Fat = 5, Calories = 75,  RowClass = "table-secondary", RowStyle = "" },
        new { Key = "HighFatMeat",   Cho = 0,  Protein = 7, Fat = 8, Calories = 100, RowClass = "table-secondary", RowStyle = "" },
        new { Key = "Fat",           Cho = 0,  Protein = 0, Fat = 5, Calories = 45,  RowClass = "",                RowStyle = "background-color: #fffacd;" }
    };
}

<div class="container-fluid py-4">
    <div class="row col-lg-8 col-md-12 col-sm-12">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-calculator"></i> @Localizer["EnergyCalculation"]
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Client Information Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h4 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-person-badge"></i> @Localizer["ClientInformation"]
                            </h4>
                        </div>

                        <!-- Row 1: Client ID, Name, Age -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">@Localizer["ClientID"]</label>
                            <input type="text" class="form-control bg-light" value="@Model.ClientId" readonly />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">@Localizer["ClientName"]</label>
                            <input type="text" class="form-control bg-light" value="@Model.ClientName" readonly />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">@Localizer["Age"]</label>
                            <input type="number" id="age" class="form-control bg-light" value="@Model.Age" readonly />
                        </div>

                        <!-- Row 2: Height and Weight -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@Localizer["Height"]</label>
                            <input type="number" id="height" class="form-control bg-light" value="@Model.Height" readonly />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@Localizer["Weight"]</label>
                            <input type="number" id="weight" class="form-control bg-light" value="@Model.Weight" readonly />
                        </div>

                        <!-- Row 3: Physical Activity Factor and Calculate Button -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">@Localizer["PhysicalActivityFactor"] *</label>
                            <select id="physicalActivityFactor" class="form-select">
                                <option value="">@Localizer["SelectPhysicalActivity"]</option>
                                @foreach (var factor in Model.PhysicalActivityFactors)
                                {
                                    <option value="@factor.Code">@factor.NameEn</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <button type="button" class="btn btn-success w-100" onclick="CalculationModule.calculateEnergy()">
                                <i class="bi bi-lightning-charge"></i> @Localizer["Calculate"]
                            </button>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">@Localizer["TotalEnergyExpenditure"]</label>
                            <div class="input-group">
                                <input type="number" id="totalEnergyExpenditure" class="form-control form-control-lg bg-warning-subtle fw-bold" value="@Model.TotalEnergyExpenditure" readonly />
                                <span class="input-group-text">@Localizer["Kcal"]</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Macronutrient Distribution Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h4 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-pie-chart"></i> @Localizer["MacronutrientDistribution"]
                            </h4>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">@Localizer["TotalCalories"]</label>
                            <div class="input-group">
                                <input type="number" id="totalCalories" class="form-control" value="@Model.TotalCalories" step="0.01" />
                                <span class="input-group-text">@Localizer["Kcal"]</span>
                            </div>
                        </div>

                        <!-- CHO% Row -->
                        <div class="col-md-2 mb-3">
                            <label class="form-label fw-bold">CHo% :</label>
                        </div>
                        <div class="col-md-5 mb-3">
                            <input type="number" id="carbsPercentage" class="form-control" placeholder="Enter CHO value (e.g., 0.45)" step="0.01" />
                        </div>
                        <div class="col-md-5 mb-3">
                            <div class="input-group">
                                <input type="number" id="carbsGrams" class="form-control bg-light" readonly />
                                <span class="input-group-text">g</span>
                            </div>
                        </div>

                        <!-- P% Row -->
                        <div class="col-md-2 mb-3">
                            <label class="form-label fw-bold">P% :</label>
                        </div>
                        <div class="col-md-5 mb-3">
                            <input type="number" id="proteinPercentage" class="form-control" placeholder="Enter Protein value (e.g., 0.30)" step="0.01" />
                        </div>
                        <div class="col-md-5 mb-3">
                            <div class="input-group">
                                <input type="number" id="proteinGrams" class="form-control bg-light" readonly />
                                <span class="input-group-text">g</span>
                            </div>
                        </div>

                        <!-- Fat% Row -->
                        <div class="col-md-2 mb-3">
                            <label class="form-label fw-bold">Fat :</label>
                        </div>
                        <div class="col-md-5 mb-3">
                            <input type="number" id="fatPercentage" class="form-control" placeholder="Enter Fat value (e.g., 0.25)" step="0.01" />
                        </div>
                        <div class="col-md-5 mb-3">
                            <div class="input-group">
                                <input type="number" id="fatGrams" class="form-control bg-light" readonly />
                                <span class="input-group-text">g</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Food Exchange List Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h4 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-table"></i> @Localizer["FoodExchangeList"]
                            </h4>
                        </div>

                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Localizer["FoodGroup"]</th>
                                            <th style="width: 120px;">@Localizer["Serving"]</th>
                                            <th style="width: 100px;">@Localizer["CHO"]</th>
                                            <th style="width: 100px;">@Localizer["P"]</th>
                                            <th style="width: 100px;">@Localizer["Fat"]</th>
                                            <th style="width: 120px;">@Localizer["Calories"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var food in foodGroups)
                                        {
                                            <tr class="@food.RowClass" style="@food.RowStyle">
                                                <td>@Localizer[food.Key]</td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm food-serving" data-group="@food.Key"
                                                           data-cho="@food.Cho" data-protein="@food.Protein" data-fat="@food.Fat" data-calories="@food.Calories"
                                                           value="0" min="0" step="0.5" />
                                                </td>
                                                <td><input type="number" class="form-control form-control-sm bg-light row-cho" value="0" title="@food.Cho / serving" readonly tabindex="-1" /></td>
                                                <td><input type="number" class="form-control form-control-sm bg-light row-protein" value="0" title="@food.Protein / serving" readonly tabindex="-1" /></td>
                                                <td><input type="number" class="form-control form-control-sm bg-light row-fat" value="0" title="@food.Fat / serving" readonly tabindex="-1" /></td>
                                                <td><input type="number" class="form-control form-control-sm bg-light row-calories" value="0" title="@food.Calories / serving" readonly tabindex="-1" /></td>
                                            </tr>
                                        }

                                        <!-- Totals Row -->
                                        <tr class="table-dark fw-bold">
                                            <td colspan="2">@Localizer["TotalGrams"]</td>
                                            <td><input type="number" id="totalCHO" class="form-control form-control-sm bg-dark text-white fw-bold" value="0" readonly /></td>
                                            <td><input type="number" id="totalProtein" class="form-control form-control-sm bg-dark text-white fw-bold" value="0" readonly /></td>
                                            <td><input type="number" id="totalFat" class="form-control form-control-sm bg-dark text-white fw-bold" value="0" readonly /></td>
                                            <td><input type="number" id="totalCaloriesFood" class="form-control form-control-sm bg-dark text-white fw-bold" value="0" readonly /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Notes Section (saved as history) -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h4 class="mb-0">
                                    <i class="bi bi-journal-text"></i> @Localizer["Notes"]
                                    <span class="badge bg-secondary" id="notesCount">@Model.NotesHistory.Count</span>
                                </h4>
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="CalculationModule.printNotes()">
                                    <i class="bi bi-printer"></i> @Localizer["PrintNotes"]
                                </button>
                            </div>
                        </div>

                        <div class="col-md-10 mb-3">
                            <textarea id="newNote" class="form-control" rows="4" dir="auto" placeholder="@Localizer["EnterNote"]"></textarea>
                        </div>
                        <div class="col-md-2 mb-3">
                            <button type="button" class="btn btn-success w-100" onclick="CalculationModule.addNote()">
                                <i class="bi bi-plus-circle"></i> @Localizer["AddNote"]
                            </button>
                        </div>

                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width: 170px;">@Localizer["Date"]</th>
                                            <th>@Localizer["Notes"]</th>
                                            <th style="width: 110px;">@Localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody id="notesBody">
                                        @* Rendered by CalculationModule.renderNotes() *@
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-center" id="notesShowMore" style="display: none;">
                                <button type="button" class="btn btn-link" onclick="CalculationModule.showAllNotes()">
                                    <i class="bi bi-chevron-down"></i> @Localizer["ShowMore"]
                                </button>
                            </div>
                            <div class="text-center" id="notesShowLess" style="display: none;">
                                <button type="button" class="btn btn-link" onclick="CalculationModule.showLessNotes()">
                                    <i class="bi bi-chevron-up"></i> @Localizer["ShowLess"]
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row">
                        <div class="col-12">
                            <a asp-controller="Client" asp-action="Edit" asp-route-id="@Model.ClientId" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> @Localizer["BackToClient"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden fields for calculation -->
<input type="hidden" id="clientId" value="@Model.ClientId" />
<input type="hidden" id="genderId" value="@Model.GenderId" />

<style>
    /* Notes-only print: everything on the page is hidden except the generated #notesPrintArea */
    #notesPrintArea { display: none; }

    @@media print {
        body.printing-notes > *:not(#notesPrintArea) { display: none !important; }
        body.printing-notes #notesPrintArea { display: block; padding: 0 10mm; font-size: 14px; }
        #notesPrintArea h3 { margin-bottom: 4px; }
        #notesPrintArea .print-meta { color: #555; margin-bottom: 16px; }
        #notesPrintArea .print-note { border-top: 1px solid #ccc; padding: 10px 0; page-break-inside: avoid; }
        #notesPrintArea .print-note-date { font-weight: bold; margin-bottom: 4px; }
        #notesPrintArea .print-note-text { white-space: pre-wrap; }
    }
</style>

@section Scripts {
    <script src="~/js/application/calculation.js" asp-append-version="true"></script>
    <script>
        // Initialize the CalculationModule
        CalculationModule.init(
            @Model.ClientId,
            @Model.GenderId,
            @Html.Raw(Json.Serialize(Localizer.GetAll())),
            @Html.Raw(Json.Serialize(Model.NotesHistory)),
            @Html.Raw(Json.Serialize(Model.ClientName)));
    </script>
}
